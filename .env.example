# EmberEdge - Environment Variables Example
# Copy this to .env and fill in your API keys

# Flask
FLASK_ENV=development
PORT=5000

# NASA FIRMS (obter em: https://firms.modaps.eosdis.nasa.gov/api/)
NASA_FIRMS_KEY=your_nasa_firms_key_here

# OpenWeatherMap (obter em: https://openweathermap.org/api)
OWM_API_KEY=your_owm_api_key_here

# Copernicus Data Space (registar em: https://dataspace.copernicus.eu/)
COPERNICUS_CLIENT_ID=your_client_id_here
COPERNICUS_CLIENT_SECRET=your_client_secret_here

# Auto-update
ENABLE_FIRMS_AUTO_UPDATE=false